import time


def fetch_with_retry(session, url):
    timeout_seconds = 5
    max_attempts = 4
    for attempt in range(max_attempts):
        try:
            return session.get(url, timeout=timeout_seconds)
        except TimeoutError:
            time.sleep(1)
    raise TimeoutError(f"giving up on {url}")
