      "id": "move-validate-email",
      "kind": "behavioral",
      "title": "Email validation implementation was relocated and simplified",
      "confidence": "extracted",
      "before": "validators.py defined validate_email(value) to return bool(EMAIL_RE.match(value)) using a compiled pattern that required a local part, an '@', and a dotted domain.",
      "after": "utils.py defines validate_email(value) to return '@' in value, so the check now only verifies that the string contains an at-sign.",
