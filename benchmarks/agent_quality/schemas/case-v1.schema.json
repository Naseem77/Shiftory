{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shiftory.dev/schemas/benchmark-agent-quality-case-v1.json",
  "title": "Shiftory agent-quality benchmark case (public prompt-package content)",
  "description": "This is the ONLY file (besides the real shiftory analyze evidence and the explain run descriptor) that is ever materialized into an agent's prompt package. It intentionally contains no expected claims, rubric text, or answer key.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "category", "description", "fixture"],
  "properties": {
    "schema": {"const": "shiftory.benchmark-agent-quality-case/v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "version": {"type": "integer", "minimum": 1},
    "category": {
      "enum": [
        "ordering-control-flow",
        "state-error-handling",
        "value-replacement-with-implications",
        "deletion-addition-confused-with-move",
        "non-text-unsupported",
        "ambiguous-context-limited"
      ]
    },
    "description": {"type": "string", "minLength": 1, "maxLength": 500},
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["history", "metadata"],
      "properties": {
        "history": {"type": "string", "minLength": 1},
        "metadata": {"type": "string", "minLength": 1}
      }
    }
  }
}
