{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shiftory.dev/schemas/explanation-v1.json",
  "title": "Shiftory explanation v1",
  "type": "object",
  "required": ["schema", "summary", "items", "coverage_owners"],
  "properties": {
    "schema": {"const": "shiftory.explanation/v1"},
    "summary": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "items": {
      "type": "array",
      "items": {"$ref": "#/$defs/item"}
    },
    "coverage_owners": {
      "type": "array",
      "items": {"$ref": "#/$defs/owner"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "nullableStatement": {
      "oneOf": [
        {"$ref": "#/$defs/nonEmptyString"},
        {"type": "null"}
      ]
    },
    "citation": {
      "oneOf": [
        {"$ref": "#/$defs/nonEmptyString"},
        {
          "type": "object",
          "required": ["id"],
          "properties": {"id": {"$ref": "#/$defs/nonEmptyString"}},
          "additionalProperties": false
        }
      ]
    },
    "item": {
      "type": "object",
      "required": ["id", "kind", "title", "confidence", "citations"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "kind": {
          "enum": ["behavioral", "structural", "observer", "ambiguity", "unresolved"]
        },
        "title": {"$ref": "#/$defs/nonEmptyString"},
        "before": {"$ref": "#/$defs/nullableStatement"},
        "after": {"$ref": "#/$defs/nullableStatement"},
        "absence": {"enum": ["before", "after", null]},
        "statement": {"$ref": "#/$defs/nonEmptyString"},
        "confidence": {
          "enum": ["extracted", "inferred", "ambiguous", "unresolved", "unavailable"]
        },
        "citations": {
          "type": "array",
          "items": {"$ref": "#/$defs/citation"}
        },
        "grounding": {"$ref": "#/$defs/grounding"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": ["kind"],
            "properties": {"kind": {"const": "behavioral"}}
          },
          "then": {
            "required": ["before", "after"],
            "oneOf": [
              {
                "properties": {
                  "before": {"$ref": "#/$defs/nonEmptyString"},
                  "after": {"$ref": "#/$defs/nonEmptyString"},
                  "absence": {"type": "null"}
                }
              },
              {
                "required": ["absence"],
                "properties": {
                  "before": {"type": "null"},
                  "after": {"$ref": "#/$defs/nonEmptyString"},
                  "absence": {"const": "before"}
                }
              },
              {
                "required": ["absence"],
                "properties": {
                  "before": {"$ref": "#/$defs/nonEmptyString"},
                  "after": {"type": "null"},
                  "absence": {"const": "after"}
                }
              }
            ]
          },
          "else": {
            "properties": {"absence": {"type": "null"}},
            "oneOf": [
              {
                "not": {
                  "anyOf": [
                    {"required": ["before"]},
                    {"required": ["after"]}
                  ]
                }
              },
              {
                "required": ["before", "after"],
                "properties": {
                  "before": {"$ref": "#/$defs/nonEmptyString"},
                  "after": {"$ref": "#/$defs/nonEmptyString"}
                }
              }
            ]
          }
        },
        {
          "if": {
            "required": ["kind"],
            "properties": {"kind": {"const": "ambiguity"}}
          },
          "then": {"properties": {"confidence": {"const": "ambiguous"}}}
        },
        {
          "if": {
            "required": ["kind"],
            "properties": {"kind": {"const": "unresolved"}}
          },
          "then": {
            "properties": {"confidence": {"enum": ["unresolved", "unavailable"]}}
          }
        },
        {
          "if": {
            "required": ["confidence"],
            "properties": {"confidence": {"const": "ambiguous"}}
          },
          "then": {"properties": {"kind": {"const": "ambiguity"}}}
        },
        {
          "if": {
            "required": ["confidence"],
            "properties": {"confidence": {"enum": ["unresolved", "unavailable"]}}
          },
          "then": {"properties": {"kind": {"const": "unresolved"}}}
        }
      ]
    },
    "owner": {
      "type": "object",
      "required": ["evidence_id", "owner_id"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/nonEmptyString"},
        "owner_id": {"$ref": "#/$defs/nonEmptyString"}
      },
      "additionalProperties": false
    },
    "claimLiteral": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "sharedSupport": {
      "type": "object",
      "required": ["evidence_id", "owner_id", "reason"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/nonEmptyString"},
        "owner_id": {"$ref": "#/$defs/nonEmptyString"},
        "reason": {"$ref": "#/$defs/nonEmptyString"}
      },
      "additionalProperties": false
    },
    "grounding": {
      "type": "object",
      "required": ["claims"],
      "properties": {
        "claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/claim"}
        }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": ["id", "type", "support_level", "support"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "type": {
          "enum": [
            "addition", "deletion", "graph_relation", "non_text_change",
            "source_order", "text_absence", "text_presence", "value_change"
          ]
        },
        "support_level": {
          "enum": ["verified", "inferred", "ambiguous", "unresolved", "unavailable"]
        },
        "support": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "shared_support": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/sharedSupport"}
        },
        "limits": {"$ref": "#/$defs/nonEmptyString"},
        "side": {"enum": ["before", "after"]},
        "literal": {"$ref": "#/$defs/claimLiteral"},
        "first": {"$ref": "#/$defs/claimLiteral"},
        "second": {"$ref": "#/$defs/claimLiteral"},
        "before_literal": {"$ref": "#/$defs/claimLiteral"},
        "after_literal": {"$ref": "#/$defs/claimLiteral"},
        "fact_kind": {
          "enum": [
            "callee", "caller", "changed_symbol", "definition",
            "enclosing_symbol", "importer", "static_test"
          ]
        },
        "symbol": {"$ref": "#/$defs/claimLiteral"},
        "target": {"$ref": "#/$defs/nonEmptyString"},
        "path": {"$ref": "#/$defs/nonEmptyString"},
        "unit_kind": {
          "enum": ["binary", "copy", "mode", "rename", "submodule", "unsupported"]
        },
        "metadata": {"type": "object"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": ["support_level"],
            "properties": {
              "support_level": {
                "enum": ["inferred", "ambiguous", "unresolved", "unavailable"]
              }
            }
          },
          "then": {"required": ["limits"]}
        },
        {
          "if": {
            "required": ["support_level"],
            "properties": {
              "support_level": {"enum": ["verified", "inferred", "ambiguous"]}
            }
          },
          "then": {"properties": {"support": {"minItems": 1}}}
        },
        {
          "if": {
            "required": ["type"],
            "properties": {"type": {"enum": ["addition", "deletion"]}}
          },
          "then": {
            "required": ["literal"],
            "$ref": "#/$defs/claimTextOnly"
          }
        },
        {
          "if": {
            "required": ["type"],
            "properties": {"type": {"enum": ["text_presence", "text_absence"]}}
          },
          "then": {
            "required": ["side", "literal"],
            "$ref": "#/$defs/claimTextOnly"
          }
        },
        {
          "if": {
            "required": ["type"],
            "properties": {"type": {"const": "source_order"}}
          },
          "then": {
            "required": ["side", "first", "second"],
            "$ref": "#/$defs/claimOrderOnly"
          }
        },
        {
          "if": {
            "required": ["type"],
            "properties": {"type": {"const": "value_change"}}
          },
          "then": {
            "required": ["before_literal", "after_literal"],
            "$ref": "#/$defs/claimValueOnly"
          }
        },
        {
          "if": {
            "required": ["type"],
            "properties": {"type": {"const": "graph_relation"}}
          },
          "then": {
            "required": ["fact_kind", "side", "symbol"],
            "$ref": "#/$defs/claimGraphOnly"
          }
        },
        {
          "if": {
            "required": ["type"],
            "properties": {"type": {"const": "non_text_change"}}
          },
          "then": {
            "required": ["unit_kind"],
            "$ref": "#/$defs/claimNonTextOnly"
          }
        }
      ]
    },
    "claimTextOnly": {
      "not": {
        "anyOf": [
          {"required": ["first"]},
          {"required": ["second"]},
          {"required": ["before_literal"]},
          {"required": ["after_literal"]},
          {"required": ["fact_kind"]},
          {"required": ["symbol"]},
          {"required": ["target"]},
          {"required": ["path"]},
          {"required": ["unit_kind"]},
          {"required": ["metadata"]}
        ]
      }
    },
    "claimOrderOnly": {
      "not": {
        "anyOf": [
          {"required": ["literal"]},
          {"required": ["before_literal"]},
          {"required": ["after_literal"]},
          {"required": ["fact_kind"]},
          {"required": ["symbol"]},
          {"required": ["target"]},
          {"required": ["path"]},
          {"required": ["unit_kind"]},
          {"required": ["metadata"]}
        ]
      }
    },
    "claimValueOnly": {
      "not": {
        "anyOf": [
          {"required": ["side"]},
          {"required": ["literal"]},
          {"required": ["first"]},
          {"required": ["second"]},
          {"required": ["fact_kind"]},
          {"required": ["symbol"]},
          {"required": ["target"]},
          {"required": ["path"]},
          {"required": ["unit_kind"]},
          {"required": ["metadata"]}
        ]
      }
    },
    "claimGraphOnly": {
      "not": {
        "anyOf": [
          {"required": ["literal"]},
          {"required": ["first"]},
          {"required": ["second"]},
          {"required": ["before_literal"]},
          {"required": ["after_literal"]},
          {"required": ["unit_kind"]},
          {"required": ["metadata"]}
        ]
      }
    },
    "claimNonTextOnly": {
      "not": {
        "anyOf": [
          {"required": ["side"]},
          {"required": ["literal"]},
          {"required": ["first"]},
          {"required": ["second"]},
          {"required": ["before_literal"]},
          {"required": ["after_literal"]},
          {"required": ["fact_kind"]},
          {"required": ["symbol"]},
          {"required": ["target"]},
          {"required": ["path"]}
        ]
      }
    }
  }
}
